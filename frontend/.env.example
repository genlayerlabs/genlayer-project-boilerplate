# GenLayer network preset: studio-next (default, hosted Studio Next, Consensus v0.6)
# or testnet-bradbury (Bradbury Phase 3). The preset supplies the consensus
# contracts, RPC URL, chain ID and chain name.
NEXT_PUBLIC_GENLAYER_NETWORK=studio-next

# Optional overrides of the preset, e.g. a self-hosted RPC of the same deployment
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
# NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
# NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio Next
# NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# GenLayer Football Betting Contract Address
# This is the address of your deployed FootballBets contract on GenLayer
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address
